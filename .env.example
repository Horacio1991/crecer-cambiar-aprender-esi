# Supabase public project settings; these two values are safe to expose in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only settings. Never add these to VITE_* variables.
# Server-only Supabase admin key. Never prefix with VITE_ or put in frontend code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Random secret used to sign 8-hour access grants. Generate with: openssl rand -base64 48
EXPEDIENTE2_TOKEN_SECRET=SET_A_LONG_RANDOM_SECRET
# Optional local API smoke test only; leave unset in production.
# EXPEDIENTE2_CODE=LOCAL_TEST_CODE

# Optional. Remains only in the Express server.
GEMINI_API_KEY=

# Render sets PORT automatically.
